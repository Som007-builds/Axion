# ─── LLM Providers ───────────────────────────────────────────
# API key for Anthropic models
ANTHROPIC_API_KEY=your-anthropic-key-here
# API key for Google Gemini models
GEMINI_API_KEY=your-gemini-key-here
# API key for Groq models
GROQ_API_KEY=your-groq-key-here
# Enable in-process caching for LLM responses (true/false)
LLM_CACHE_ENABLED=false

# ─── Neo4j Database ──────────────────────────────────────────
# URI for the Neo4j instance (host port 7887 matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7887
# Username for Neo4j authentication
NEO4J_USERNAME=neo4j
# Password for Neo4j authentication
NEO4J_PASSWORD=your-neo4j-password-here
# Name of the Neo4j docker container (if applicable)
NEO4J_CONTAINER_NAME=axion_neo4j

# ─── API / CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Scheduler ───────────────────────────────────────────────
# Run the periodic ingestion scheduler inside the API process.
# Requires a single API worker (uvicorn --workers 1).
SCHEDULER_ENABLED=false
# Interval in hours for the ingestion scheduler
SCHEDULER_INTERVAL_HOURS=6
# Number of papers to process per scheduler run
SCHEDULER_PAPERS_PER_RUN=5

# ─── Security ────────────────────────────────────────────────
# Secret token required to trigger ingestion endpoints.
# The API fails closed: if TRIGGER_SECRET is empty, ingestion trigger
# endpoints return 503 and are never left open to anonymous callers.
# Also set NEXT_PUBLIC_TRIGGER_SECRET (same value) in axion/.env.local
# for the frontend's ingestion controls, and NEXT_PUBLIC_API_URL.
TRIGGER_SECRET=your-trigger-secret-here

# ─── Frontend (Axion) ────────────────────────────────────────
# Base URL the frontend uses to reach this API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Secret token required by the frontend to call ingestion endpoints
NEXT_PUBLIC_TRIGGER_SECRET=your-trigger-secret-here

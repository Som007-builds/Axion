# ─── LLM Providers ───────────────────────────────────────────
# API key for Anthropic models
ANTHROPIC_API_KEY=your-anthropic-key-here
# API key for Google Gemini models
GEMINI_API_KEY=your-gemini-key-here
# API key for Groq models
GROQ_API_KEY=your-groq-key-here
# Enable in-process caching for LLM responses (true/false)
LLM_CACHE_ENABLED=false
# Model id for the fallback provider (Groq's model id lives in config.py)
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x spends hidden "thinking" tokens on every call; 0 turns that off
GEMINI_THINKING_BUDGET=0
# Seconds a provider is benched after a hard failure (bad key, hard 4xx)
LLM_PROVIDER_COOLDOWN_SECONDS=300

# ─── Contradiction detection ─────────────────────────────────
# Maximum cosine distance for a claim pair to be sent to the LLM judge.
# Measured on the current index: 0.95 (the old value) let 100% of retrieved
# pairs through; 0.35 keeps ~43% of them while 80% of claims still have a
# candidate. Raise it to judge more pairs, lower it to judge fewer.
CONTRADICTION_MAX_DISTANCE=0.35

# ─── Neo4j Database ──────────────────────────────────────────
# URI for the Neo4j instance (host port 7887 matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7887
# Username for Neo4j authentication
NEO4J_USERNAME=neo4j
# Password for Neo4j authentication
NEO4J_PASSWORD=your-neo4j-password-here
# Name of the Neo4j docker container (if applicable)
NEO4J_CONTAINER_NAME=axion_neo4j

# ─── API / CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Scheduler ───────────────────────────────────────────────
# Run the periodic ingestion scheduler inside the API process.
# Requires a single API worker (uvicorn --workers 1).
SCHEDULER_ENABLED=false
# Interval in hours for the ingestion scheduler
SCHEDULER_INTERVAL_HOURS=6
# Number of papers to process per scheduler run
SCHEDULER_PAPERS_PER_RUN=5

# ─── Background job queue (Redis) ────────────────────────────
# Durable queue for ingestion and research queries. The API enqueues, the
# `worker` service executes, and job state is shared through Redis so results
# survive an API restart.
# Leave empty to fall back to in-process threads (local dev/tests only: jobs
# are then lost on restart and job state is per-process).
# The compose default targets the bundled redis service.
REDIS_URL=redis://redis:6379/0
# How long finished job records/results are kept (seconds)
JOB_TTL_SECONDS=86400
# Maximum wall-clock time for a single job (seconds)
JOB_TIMEOUT_SECONDS=1800

# ─── Security ────────────────────────────────────────────────
# Shared secret required by every write/compute endpoint and by job polling:
#   POST /api/query, POST /api/experiments/{id}/design,
#   POST /api/confidence/recalculate, POST /api/ingestion/{trigger,custom},
#   GET  /api/jobs/{job_id}
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(36))"
# The frontend sends it from its server-side proxy (axion/app/api/backend)
# as the X-API-Key header, so it is never shipped to the browser bundle.
# The API fails closed: if this is empty, those endpoints return 503.
AXION_API_KEY=your-api-key-here

# Legacy secret for the two ingestion trigger endpoints (X-Trigger-Secret).
# Superseded by AXION_API_KEY; leave empty unless you still have clients
# sending the old header.
TRIGGER_SECRET=

# ─── Frontend (Axion) ────────────────────────────────────────
# Base URL the browser uses to reach this API (public, baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL the frontend's server-side proxy uses at runtime. Inside docker compose
# this is the internal service address; local `pnpm dev` falls back to
# NEXT_PUBLIC_API_URL when unset.
AXION_API_URL=http://api:8000

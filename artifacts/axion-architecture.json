  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence path",
      "items": [
        "arXiv is the only source; PDFs are parsed into 800/100-character chunks",
        "Each claim keeps its section, base confidence, and evidence span",
        "Neo4j and ChromaDB are written independently, not transactionally"
      ]
    },
    {
      "dot": "violet",
      "title": "Reasoning rules",
      "items": [
        "Contradictions pass a vector-distance gate, then an LLM judge and a three-part guard",
        "Confidence = base + 0.08·supports − 0.12·contradictions, clamped to [0.05, 0.98]",
        "Reader, analysis agents, and Coordinator v2 all call llm.py"
      ]
    },
    {
      "dot": "rose",
      "title": "Honest gaps",
      "items": [
        "One shared AXION_API_KEY; no per-user identity or TLS",
        "Gap confidence is not persisted, so the API returns null",
        "Only 4 CONTRADICTS pairs, so judge precision and recall stay indicative"
      ]
    }
  ]
